# Copy to .env (gitignored) and fill in, or export these in your shell.
# A read-scoped API token; see README for the permission checklist.
CLOUDFLARE_API_TOKEN=your_api_token_here

# The account to report on (32-char hex). Optional if your token can list accounts and you have exactly one.
CLOUDFLARE_ACCOUNT_ID=

# Optional: S3 credentials for the R2 bucket listing fallback
# (create an R2 API token with Object Read in the R2 dashboard)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
